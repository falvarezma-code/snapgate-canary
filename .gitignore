# Scratch state from `snapgate check`; baselines/ is committed on purpose.
.snapgate/last/
# Local experiment output from scripts/determinism.sh
.determinism/
# Per-run JSON reports from scripts/check.sh
.snapgate/reports/
# Ollama baselines are per CPU model and live under hosts/<cpu>/baselines/;
# scripts/host-baselines.sh copies the matching set here at run time.
.snapgate/baselines/*.ollama.json
